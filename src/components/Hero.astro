---
import { site } from '../data/site';
import CopyEmail from './CopyEmail.astro';
import Terminal from './Terminal.astro';
---

<section id="top" class="hero">
  <div class="glow-blob blob-a" aria-hidden="true"></div>
  <div class="glow-blob blob-b" aria-hidden="true"></div>
  <div class="cursor-glow" data-hero-glow aria-hidden="true"></div>

  <div class="wrap hero-inner">
    <!-- ─────────────────────────────────────────────── left: the pitch -->
    <div class="hero-text">
      <span class="badge">
        <span class="dot-wrap" aria-hidden="true">
          <span class="ping ping-dot"></span>
          <span class="live-dot"></span>
        </span>
        {site.kicker}
      </span>

      <h1>
        {site.headline}
      </h1>

      <div class="lede stack">
        <p set:html={site.lede} />
      </div>

      <div class="hero-actions">
        <a href={site.resume} class="btn btn-ghost">
          Resume <span aria-hidden="true">↓</span>
        </a>
        <CopyEmail class="btn btn-ghost" />
      </div>

      <p class="now-line">
        {
          site.status && (
            <span class="status">
              <span class="pulse-dot dot" />
              {site.status}
            </span>
          )
        }
        <span class="sep" aria-hidden="true">·</span>
        <span>{site.location}</span>
        <span class="sep" aria-hidden="true">·</span>
        <a href={site.github} rel="me noopener" class="body-link">GitHub</a>
        <a href={site.linkedin} rel="me noopener" class="body-link"
          >LinkedIn</a
        >
      </p>
    </div>

    <!-- ──────────────────────────────────────────── right: the terminal -->
    <div class="hero-panel">
      <Terminal />
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    padding-top: var(--space-2xl);
    padding-bottom: var(--space-xl);
  }

  .blob-a {
    top: -8rem;
    right: -6rem;
    width: 26rem;
    height: 26rem;
    background: radial-gradient(
      closest-side,
      rgb(52 211 153 / 0.16),
      transparent
    );
  }
  .blob-b {
    bottom: -14rem;
    left: -8rem;
    width: 26rem;
    height: 26rem;
    background: radial-gradient(
      closest-side,
      rgb(45 212 191 / 0.1),
      transparent
    );
  }

  /* Soft mint pool that trails the pointer across the hero. Sits under the
     content and never intercepts clicks. Mouse-only. */
  .cursor-glow {
    position: absolute;
    top: 0;
    left: 0;
    width: 34rem;
    height: 34rem;
    margin: -17rem 0 0 -17rem;
    border-radius: 50%;
    pointer-events: none;
    opacity: 0;
    background: radial-gradient(
      closest-side,
      rgb(52 211 153 / 0.1),
      transparent
    );
    transition: opacity 0.5s var(--ease);
    will-change: transform;
  }

  @media (hover: none), (prefers-reduced-motion: reduce) {
    .cursor-glow {
      display: none;
    }
  }

  .hero-inner {
    position: relative;
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-xl);
    align-items: center;
  }

  @media (min-width: 62rem) {
    .hero {
      padding-top: var(--space-3xl);
      min-height: 84svh;
      display: grid;
      align-content: center;
    }
    .hero-inner {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: var(--space-2xl);
    }
  }

  .hero-text {
    max-width: var(--width-text);
  }

  .badge {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.35rem 0.9rem;
    border: 1px solid color-mix(in srgb, var(--accent) 30%, transparent);
    background: var(--accent-wash);
    border-radius: var(--radius-pill);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--accent-ink);
  }

  .dot-wrap {
    position: relative;
    display: inline-flex;
    width: 8px;
    height: 8px;
  }
  .ping-dot,
  .live-dot {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: var(--accent);
  }
  .ping-dot {
    opacity: 0.6;
  }

  h1 {
    margin-top: var(--space-m);
  }

  .lede {
    margin-top: var(--space-m);
    font-size: var(--step-1);
    color: var(--ink-soft);
  }
  .lede :global(strong) {
    color: var(--accent-ink);
    font-weight: 600;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-s);
    margin-top: var(--space-l);
  }

  .now-line {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.6em;
    margin-top: var(--space-m);
    font-size: 0.9rem;
    color: var(--ink-soft);
  }

  .status {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    padding: 0.15em 0.75em 0.15em 0.6em;
    border: 1px solid color-mix(in srgb, var(--accent) 30%, transparent);
    background: var(--accent-wash);
    border-radius: var(--radius-pill);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--accent-ink);
  }

  .dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent);
  }

  .sep {
    color: var(--ink-faint);
  }
</style>

<script>
  const hero = document.querySelector<HTMLElement>('#top');
  const glow = hero?.querySelector<HTMLElement>('[data-hero-glow]');
  const fine = matchMedia('(hover: hover) and (pointer: fine)').matches;
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (hero && glow && fine && !reduce) {
    let x = 0;
    let y = 0;
    let frame = 0;

    const draw = () => {
      frame = 0;
      glow.style.transform = `translate3d(${x}px, ${y}px, 0)`;
    };

    hero.addEventListener(
      'pointermove',
      (e) => {
        const r = hero.getBoundingClientRect();
        x = e.clientX - r.left;
        y = e.clientY - r.top;
        if (!frame) frame = requestAnimationFrame(draw);
      },
      { passive: true },
    );

    hero.addEventListener('pointerenter', () => (glow.style.opacity = '1'));
    hero.addEventListener('pointerleave', () => (glow.style.opacity = '0'));
  }
</script>
