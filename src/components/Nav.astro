---
import { site } from '../data/site';

// Root-relative, not bare fragments: the nav also renders on /404, where
// "#about" would resolve against the bad path and go nowhere. From the home
// page "/#about" is still a same-document jump, so smooth scroll is intact.
const links = [
  { href: '/#about', label: 'About' },
  { href: '/#skills', label: 'Stack' },
  { href: '/#projects', label: 'Projects' },
  { href: '/#experience', label: 'Experience' },
  // `optional` drops out on very narrow phones where five links overflow.
  // The game is still reachable by scrolling and from the footer ⚽.
  { href: '/#kickups', label: 'Play', optional: true },
];
---

<header class="site-header">
  <nav class="wrap inner" aria-label="Main">
    <a href="/#top" class="brand" aria-label="Back to top">
      <span class="brand-full">karan<span class="dot">.</span>cloud</span>
      <span class="brand-short" aria-hidden="true"
        >k<span class="dot">.</span></span
      >
    </a>

    <div class="right">
      <ul class="links">
        {
          links.map((l) => (
            <li class={l.optional ? 'optional' : undefined}>
              <a href={l.href} class="nav-link">
                {l.label}
              </a>
            </li>
          ))
        }
        <li class="cta-item">
          <a href="/#contact" class="btn btn-outline">Get in touch</a>
        </li>
      </ul>

      <button
        id="theme-toggle"
        type="button"
        class="toggle"
        aria-label="Toggle colour theme"
      >
        <svg
          class="icon-moon"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.7"
          aria-hidden="true"
        >
          <path d="M12 3a9 9 0 1 0 9 9 7 7 0 0 1-9-9Z" stroke-linejoin="round"
          ></path>
        </svg>
        <svg
          class="icon-sun"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.7"
          aria-hidden="true"
        >
          <circle cx="12" cy="12" r="4"></circle>
          <path
            d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"
            stroke-linecap="round"></path>
        </svg>
      </button>
    </div>
  </nav>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--bg) 80%, transparent);
    backdrop-filter: blur(14px) saturate(1.3);
    border-bottom: 1px solid
      color-mix(in srgb, var(--line) 75%, transparent);
  }

  .inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-m);
    height: 4rem;
  }

  .brand {
    font-family: var(--font-mono);
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--ink);
    transition: color var(--t-fast);
  }
  .brand:hover {
    color: var(--accent-ink);
  }
  .dot {
    color: var(--accent);
  }

  .right {
    display: flex;
    align-items: center;
    gap: var(--space-m);
  }

  .links {
    display: flex;
    align-items: center;
    gap: var(--space-m);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .nav-link {
    position: relative;
    font-size: 0.9rem;
    color: var(--ink-soft);
    transition: color var(--t-fast);
  }
  .nav-link:hover {
    color: var(--accent-ink);
  }

  /* Underline grows from the centre as a section becomes current. */
  .nav-link::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -0.4rem;
    height: 1.5px;
    border-radius: 2px;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: center;
    transition: transform var(--t-norm);
  }
  .nav-link.active {
    color: var(--accent-ink);
  }
  .nav-link.active::after {
    transform: scaleX(1);
  }

  @media (prefers-reduced-motion: reduce) {
    .nav-link::after {
      transition: none;
    }
  }

  .toggle {
    display: grid;
    place-items: center;
    width: 2.1rem;
    height: 2.1rem;
    border-radius: var(--radius-s);
    border: 1px solid var(--line-strong);
    background: var(--surface);
    color: var(--ink-soft);
    transition:
      color var(--t-fast),
      border-color var(--t-fast);
  }
  .toggle:hover {
    color: var(--accent-ink);
    border-color: var(--accent);
  }
  .toggle svg {
    width: 1rem;
    height: 1rem;
  }

  /* Show the icon for the theme you'd switch TO. */
  .icon-sun {
    display: none;
  }
  :global([data-theme='light']) .icon-sun {
    display: none;
  }
  :global([data-theme='light']) .icon-moon {
    display: block;
  }
  :global(html:not([data-theme='light'])) .icon-moon {
    display: none;
  }
  :global(html:not([data-theme='light'])) .icon-sun {
    display: block;
  }

  .brand-short {
    display: none;
  }

  /* Five links plus a CTA plus a toggle don't fit a phone. Drop the CTA
     (Contact is still reachable by scrolling) and shorten the wordmark to
     its monogram — that alone frees ~70px, more than the overflow. */
  @media (max-width: 52rem) {
    .cta-item {
      display: none;
    }
    .brand-full {
      display: none;
    }
    .brand-short {
      display: inline;
    }
    .links {
      gap: 0.85rem;
    }
    .nav-link {
      font-size: 0.8rem;
    }
    .right {
      gap: 0.85rem;
    }
  }

  @media (max-width: 25rem) {
    .links {
      gap: 0.6rem;
    }
    .nav-link {
      font-size: 0.74rem;
    }
    .right {
      gap: 0.6rem;
    }
  }

  /* At ~320px even five tightened links overflow and push the theme toggle
     off screen. Drop the one marked optional. */
  @media (max-width: 22rem) {
    .links li.optional {
      display: none;
    }
  }
</style>

<script>
  document.getElementById('theme-toggle')?.addEventListener('click', () => {
    const root = document.documentElement;
    if (root.dataset.theme === 'light') {
      delete root.dataset.theme;
      localStorage.setItem('theme', 'dark');
    } else {
      root.dataset.theme = 'light';
      localStorage.setItem('theme', 'light');
    }
  });

  /* ── scroll spy ──────────────────────────────────────────────────────
     Marks the nav link for whichever section is crossing the middle of the
     viewport. Only runs where those sections exist, so /404 is a no-op. */
  (() => {
    const links = new Map<string, HTMLAnchorElement>();
    document
      .querySelectorAll<HTMLAnchorElement>('.site-header .nav-link')
      .forEach((a) => {
        const id = (a.getAttribute('href') ?? '').split('#')[1];
        if (id && document.getElementById(id)) links.set(id, a);
      });
    if (links.size === 0) return;

    // Document order, so ties resolve to the section nearer the top.
    const order = [...links.keys()].sort(
      (a, b) =>
        document.getElementById(a)!.offsetTop -
        document.getElementById(b)!.offsetTop,
    );

    const visible = new Set<string>();
    let current: string | null = null;

    const paint = (id: string | null) => {
      if (id === current) return;
      current = id;
      links.forEach((a, key) => {
        const on = key === id;
        a.classList.toggle('active', on);
        if (on) a.setAttribute('aria-current', 'true');
        else a.removeAttribute('aria-current');
      });
    };

    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (e.isIntersecting) visible.add(e.target.id);
          else visible.delete(e.target.id);
        }
        // Nothing in the band (top of page, or between sections) — leave the
        // last one lit rather than flickering to nothing.
        const next = order.find((id) => visible.has(id));
        if (next) paint(next);
      },
      // Shrink the root to a band across the middle of the viewport.
      { rootMargin: '-45% 0px -45% 0px', threshold: 0 },
    );

    order.forEach((id) => io.observe(document.getElementById(id)!));

    // At the very top nothing should be marked — you're in the hero.
    const clearAtTop = () => {
      if (window.scrollY < 80) paint(null);
    };
    addEventListener('scroll', clearAtTop, { passive: true });
    clearAtTop();
  })();
</script>
